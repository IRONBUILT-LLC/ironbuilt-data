        1
      ],
      "wording": "original",
      "automated": false,
      "summary": "Once each turning point, choose one benefit: a firefight ploy costs 0CP when this Captain is its specified ANGEL OF DEATH operative, except Command Re-roll; or, when a friendly ANGEL OF DEATH activates, use Combat Doctrine at its usual CP cost if the Captain is in the killzone and outside enemy control range, provided that ploy has not already been used this turning point; or use Adjust Doctrine for 0CP while the Captain is in the killzone and outside enemy control range.",
      "mechanics": {
        "limit": {
          "uses": 1,
          "period": "turning point",
          "sharedAcrossOptions": true
        },
        "options": [
          {
            "ployType": "firefight",
            "costCP": 0,
            "target": "this Captain as specified ANGEL OF DEATH operative",
            "exceptions": [
              "Command Re-roll"
            ]
          },
          {
            "ploy": "Combat Doctrine",
            "trigger": "friendly ANGEL OF DEATH activation",
            "cost": "normal",
            "conditions": [
              "Captain in killzone",
              "Captain outside enemy control range",
              "Combat Doctrine not already used this turning point"
            ]
          },
          {
            "ploy": "Adjust Doctrine",
            "costCP": 0,
            "conditions": [
              "Captain in killzone",
              "Captain outside enemy control range"
            ]
          }
        ]
      }
    },
